# ============================================================
# zsh-mockingbird 配置文件
#
# 使用方法：
#   1) 复制本文件为 config.env
#      cp config.env.example config.env
#   2) 填入你的 MOCKINGBIRD_API_KEY
#   3) 重新加载：source ~/.zshrc
#
# ============================================================

# 大模型 API Key
MOCKINGBIRD_API_KEY=""

# API 完整地址（OpenAI格式）
# 请填完整端点，不同厂商不一样：（例）
#   DeepSeek:   https://api.deepseek.com/chat/completions
#   阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
MOCKINGBIRD_API_URL=""

# 模型名称
MOCKINGBIRD_MODEL=""

# 语气风格：sarcastic（阴阳怪气）/ angry（祖安暴躁）/ tsundere（傲娇）
MOCKINGBIRD_TONE="sarcastic"

# 流式输出：1 开启（SSE 流式）/ 0 关闭（一次性返回）
MOCKINGBIRD_STREAM="0"

# 请求超时（秒），超过则自动回退到本地毒舌语录
MOCKINGBIRD_TIMEOUT="3.0"
