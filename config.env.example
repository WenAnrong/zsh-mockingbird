# ============================================================
# zsh-mockingbird 配置文件
#
# 使用方法：
#   1) 复制本文件为 config.env（install.sh 会自动完成）
#      cp config.env.example config.env
#   2) 填入你的 MOCKINGBIRD_API_KEY
#   3) 重新加载：source ~/.zshrc
# ============================================================

# ---------- 必填 ----------
# 大模型 API Key（OpenAI 兼容格式，支持 DeepSeek / Qwen / Moonshot 等）
MOCKINGBIRD_API_KEY=""

# ---------- 可选 ----------
# API 地址（会自动拼接 /chat/completions）
# DeepSeek:     https://api.deepseek.com
# 阿里云百炼:   https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot:     https://api.moonshot.cn/v1
MOCKINGBIRD_BASE_URL="https://api.deepseek.com"

# 模型名称
# DeepSeek:  deepseek-chat / deepseek-reasoner
# 阿里云:    qwen-plus
# Moonshot:  moonshot-v1-8k
MOCKINGBIRD_MODEL="deepseek-chat"

# 语气风格：sarcastic（阴阳怪气）/ angry（祖安暴躁）/ tsundere（傲娇）
MOCKINGBIRD_TONE="sarcastic"

# 流式输出：1 开启（SSE 流式）/ 0 关闭（一次性返回）
MOCKINGBIRD_STREAM="0"

# 请求超时（秒），超过则自动回退到本地毒舌语录
MOCKINGBIRD_TIMEOUT="3.0"
