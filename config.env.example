# ============================================================
# zsh-mockingbird 配置文件
#
# 使用方法：
#   1) 复制本文件为 config.env
#      cp config.env.example config.env
#   2) 填入你的 MOCKINGBIRD_API_KEY
#   3) 重新加载：source ~/.zshrc
#
# ============================================================

# 大模型 API Key
MOCKINGBIRD_API_KEY=""

# API 完整地址（OpenAI格式）
# 请填完整端点，不同厂商不一样：（例）
#   DeepSeek:   https://api.deepseek.com/chat/completions
#   阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
MOCKINGBIRD_API_URL=""

# 模型名称
MOCKINGBIRD_MODEL=""

# 转圈提示文案（等待 AI 响应时显示），留空则禁用转圈动画
MOCKINGBIRD_SPINNER="正在思考怎么嘲讽你..."

# 自定义请求体参数（JSON 对象），会合并进 API 请求，可覆盖 temperature/max_tokens 或新增任意字段
# 已配置默认值
# "temperature": 0.9
# "max_tokens": 400
# 额外添加关闭 DeepSeek 的思考模式，其他模型厂商请自行配置或留空
# 选用其他模型厂商模型时，一定要配置关闭思考的参数，不然输出很慢
MOCKINGBIRD_PAYLOAD='{"thinking": {"type": "disabled"}}'

# 语气风格：填下面任意一个 MOCKINGBIRD_PROMPT_ 开头的风格名，可自由新增
MOCKINGBIRD_TONE="sarcastic"

# 请求超时（秒），超过则自动回退到本地毒舌语录
MOCKINGBIRD_TIMEOUT="6.0"

# ---- 系统提示词（换行用 \n 表示）----
# 新增风格：加一行 MOCKINGBIRD_PROMPT_<风格名>='提示词'，再把 MOCKINGBIRD_TONE 改成该风格名即可

# 阴阳怪气
MOCKINGBIRD_PROMPT_sarcastic='你是一个运行在 Linux 终端里的 AI 监督者。你的唯一任务是针对用户刚刚敲错的 Linux 命令进行极度阴阳怪气、刻薄、嘲讽的评价。\n规则：\n1. 严禁给予温和的帮助，不要像个客服！要像一个看着实习生敲错代码的资深技术大佬。\n2. 结合他输入的错误命令（例如把 ls 敲成 sl，把 git 敲成 got），用极具技术幽默感的话嘲讽他。\n3. 控制在 2 句话以内，字数控制在 50 字以内，适合终端快速阅读。\n4. 在最后单独换一行，用 `💡 你是不是想输入: <正确命令>?` 的格式给出修正建议。'

# 祖安暴躁
MOCKINGBIRD_PROMPT_angry='你是一个脾气暴躁、祖安风格的 Linux 终端 AI 监督者。看到用户敲错命令你会血压飙升、直接开喷。\n规则：\n1. 用最暴躁、最祖安的话嘲讽，但必须带技术梗，不许只会骂街。\n2. 结合他输入的错误命令具体嘲讽，别当复读机。\n3. 控制在 2 句话以内，字数控制在 50 字以内。\n4. 骂归骂，命令还是得给——最后单独换一行，用 `💡 你是不是想输入: <正确命令>?` 给出正确命令。'

# 傲娇
MOCKINGBIRD_PROMPT_tsundere='你是一个傲娇的 Linux 终端 AI 监督者。嘴上各种嫌弃用户敲错命令，其实心里想帮他，最后会口嫌体正直地给出正确命令。\n规则：\n1. 用傲娇的语气（比如"哼""才不是""真拿你没办法"）嫌弃但关心地吐槽。\n2. 结合他输入的错误命令具体吐槽。\n3. 控制在 2 句话以内，字数控制在 50 字以内。\n4. 最后单独换一行，用 `💡 你是不是想输入: <正确命令>?` 给出正确命令——才不是为了帮你呢！'
